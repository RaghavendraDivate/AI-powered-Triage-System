# Development environment configuration for Hospital System Frontend

# API Base URL - Backend server address
VITE_API_BASE_URL=http://localhost:8000

# Google Cloud Project ID (your actual project)
GCP_PROJECT=ai-chatbot-475804

# Google Cloud Region where Gemini API is available
GCP_LOCATION=asia-south1

# Gemini Model to use
GEMINI_MODEL=gemini-2.5-chat

# Google API Key or Bearer Token for authentication (keep secret)
GOOGLE_API_KEY=AIzaSyDfr3LImy9enytwF-4Y7bU2eeBtE1H-Vh8

# Optional: You can add other environment-specific variables here


# Development mode settings
VITE_APP_ENV=development

# API timeout settings (in milliseconds)
VITE_API_TIMEOUT=30000

# Enable development features
VITE_DEBUG_MODE=true

# Chat settings
VITE_MAX_RETRY_ATTEMPTS=3
VITE_RETRY_DELAY=3000

# Local storage settings
VITE_STORAGE_PREFIX=hospital_system_

# Feature flags
VITE_ENABLE_CHAT_PERSISTENCE=true
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_ANALYTICS=false

# UI settings
VITE_TOAST_DURATION=5000
VITE_AUTO_SCROLL_CHAT=true

# Development tools
VITE_SHOW_API_LOGS=true
VITE_ENABLE_MOCK_DATA=false

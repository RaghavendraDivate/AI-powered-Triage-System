# Production environment configuration for Hospital System Frontend

# API Base URL - Production backend server address
# Update this to your production backend URL
VITE_API_BASE_URL=https://your-production-api.com

# Production mode settings
VITE_APP_ENV=production

# API timeout settings (in milliseconds)
VITE_API_TIMEOUT=45000

# Disable development features
VITE_DEBUG_MODE=false

# Chat settings
VITE_MAX_RETRY_ATTEMPTS=2
VITE_RETRY_DELAY=5000

# Local storage settings
VITE_STORAGE_PREFIX=hospital_system_

# Feature flags
VITE_ENABLE_CHAT_PERSISTENCE=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=true

# UI settings
VITE_TOAST_DURATION=4000
VITE_AUTO_SCROLL_CHAT=true

# Production optimizations
VITE_SHOW_API_LOGS=false
VITE_ENABLE_MOCK_DATA=false

# Security settings
VITE_ENABLE_CSP=true
VITE_SECURE_COOKIES=true

# Performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_SENTRY_DSN=your-sentry-dsn-here

# Cache settings
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_VERSION=1.0.0
